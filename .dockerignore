# Frontend .dockerignore
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 테스트 및 개발 파일
src/**/*.test.js
src/**/*.test.jsx
src/**/*.test.ts
src/**/*.test.tsx
**/__tests__/
**/__mocks__/
coverage/

# 빌드 결과물 (다단계 빌드에서 제외)
build/
dist/

# 환경 설정 파일
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE 및 에디터
.vscode/
.idea/
*.swp
*.swo

# OS 생성 파일
.DS_Store
Thumbs.db

# Git 관련
.git/
.gitignore
README.md
CHANGELOG.md

# CI/CD 관련
.github/
.gitlab-ci.yml
docker-compose*.yml
Dockerfile.dev